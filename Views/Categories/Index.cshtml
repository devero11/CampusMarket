@model List<CampusMarket.Models.Category>

@{
    ViewData["Title"] = "Categorii";
}

<h2 class="text-center">Afișare categorii</h2>
<br />

@if (TempData["message"] != null)
{
    <div class="alert alert-success p-3 rounded-3 text-center mb-4">
        @TempData["message"]
    </div>
}

<div class="d-flex justify-content-center gap-2 mb-4">
    <a class="btn btn-outline-success" asp-controller="Categories" asp-action="New">Adaugă categorie</a>
</div>

@if (!Model.Any())
{
    <p class="text-center text-muted">Nu există categorii adăugate momentan.</p>
}
else
{
    @foreach (var category in Model)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">@category.Name</h4>

                <div class="d-flex gap-2">
                    <a class="btn btn-success" asp-controller="Categories" asp-action="Show" asp-route-id="@category.Id">Afișare categorie</a>
                    <a class="btn btn-outline-success" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id">Editează</a>
                </div>
            </div>
        </div>
    }
}