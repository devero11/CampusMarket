@model CampusMarket.Models.Category

@{
    ViewData["Title"] = "Adăugare categorie";
}

<h2 class="text-center mt-5">Adăugare categorie</h2>

<div class="container mt-4">
    <div class="row">
        <div class="col-6 offset-3">
            <form method="post" asp-controller="Categories" asp-action="New">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-success" type="submit">Adaugă categoria</button>
                    <a class="btn btn-outline-secondary" asp-controller="Categories" asp-action="Index">Înapoi</a>
                </div>
            </form>
        </div>
    </div>
</div>