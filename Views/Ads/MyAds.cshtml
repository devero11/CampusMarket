@model IEnumerable<CampusMarket.Models.Ad>

@{
    ViewData["Title"] = "Anunturile mele";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Anunturile mele</h2>
    <a asp-controller="Ads" asp-action="New" class="btn btn-primary">+ Adauga anunt</a>
</div>

@if (TempData["message"] != null)
{
    <div class="alert alert-success">@TempData["message"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Nu ai adaugat niciun anunt inca.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Imagine</th>
                <th>Titlu</th>
                <th>Categorie</th>
                <th>Pret</th>
                <th>Stoc</th>
                <th>Stare</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ad in Model)
            {
                <tr>
                    <td>
                        <img src="@ad.ImageUrl" alt="@ad.Title" style="width: 70px; height: 70px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@ad.Title</td>
                    <td>@ad.Category?.Name</td>
                    <td>@ad.Price RON</td>
                    <td>@ad.Stock</td>
                    <td>@ad.Condition</td>
                    <td>
                        @if (ad.Status == "In asteptare")
                        {
                            <span class="badge bg-warning text-dark">In asteptare</span>
                        }
                        else if (ad.Status == "Aprobat")
                        {
                            <span class="badge bg-success">Aprobat</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@ad.Status</span>
                            if (!string.IsNullOrEmpty(ad.AdminFeedback))
                            {
                                <div class="text-danger small mt-1">@ad.AdminFeedback</div>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}